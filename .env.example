# Copy to .env. Absolute path of the folder holding in/ (ingested), out/ (dbt outputs) and report/.
# Unset, dbt, Dagster and the notebook fall back to data/ in the repo.
WEATHER_DATA_DIR=/path/to/dbt-de-weather/data
# Absolute path of the DuckDB file dbt builds into. Unset, dbt uses weather.duckdb in the repo.
WEATHER_DB_PATH=/path/to/dbt-de-weather/weather.duckdb

# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# dbt / DuckDB build artifacts
dbt/target/
dbt/logs/
dbt/.user.yml
dbt/dbt_packages/
*.duckdb
*.duckdb.wal

# Dagster run history (DAGSTER_HOME, see Makefile), and the lock it takes while running dbt deps
.dagster/
*.concurrent-update-lock

# macOS
.DS_Store

# Local Data etc (the folders are kept via .gitkeep; dbt-duckdb can't write external models into
# a missing data/stg or data/prod)
data/raw/*
!data/raw/.gitkeep
data/stg/*
!data/stg/.gitkeep
data/prod/*
!data/prod/.gitkeep
data/report/*
!data/report/.gitkeep

# Notebooks
__marimo__

# Dagster leftovers
.dagster/
orchestrator/

# Local settings (template: .env.example)
.env

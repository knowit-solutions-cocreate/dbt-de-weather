# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# dbt / DuckDB build artifacts
dbt/target/
dbt/logs/
dbt/.user.yml
dbt/dbt_packages/
*.duckdb
*.duckdb.wal

# Dagster run history (DAGSTER_HOME, see Makefile), and the lock it takes while running dbt deps
.dagster/
*.concurrent-update-lock

# macOS
.DS_Store

# Local Data etc (the folders are kept via .gitkeep; dbt-duckdb can't write external models into
# a missing data/out)
data/in/*
!data/in/.gitkeep
data/out/*
!data/out/.gitkeep
data/report/*
!data/report/.gitkeep

# Notebooks
__marimo__

# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# dbt / DuckDB build artifacts
dbt/target/
dbt/logs/
dbt/.user.yml
dbt/dbt_packages/

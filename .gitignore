CLAUDE.md

# Local Data etc (the folders are kept via .gitkeep; dbt-duckdb can't write external models into
# a missing data/out)
data/in/*
!data/in/.gitkeep
data/out/*
!data/out/.gitkeep
data/report/*
!data/report/.gitkeep
data/.DS_Store


# Notebooks
__marimo__

# Dagster leftovers
.dagster/
orchestrator/

# Environment vars
.env
